# Veri-Scholars — Environment Variables
# Copy this file to .env and fill in production values.

# --- Database ---
# PostgreSQL connection string for production.
# Omit to fallback to local SQLite (certificates.db) for development.
# DATABASE_URL=postgresql://user:password@host:5432/verischolars_db

# --- Security ---
# Secret key for HMAC-SHA256 document hash verification.
# MUST be set in production. The app uses a default dev key if unset.
# VERI_HASH_SECRET=your-super-secret-key-here
